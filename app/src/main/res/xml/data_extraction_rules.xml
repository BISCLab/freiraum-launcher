<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing goes to a cloud backup (like allowBackup="false" before).
     Moving to a new phone by cable or nearby transfer, which the person starts, stays possible. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
